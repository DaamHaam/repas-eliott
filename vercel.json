{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd repas-eliott && npm ci --legacy-peer-deps",
  "buildCommand": "cd repas-eliott && npm run build",
  "outputDirectory": "repas-eliott/dist",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ]
}
